# --- DEPLOYMENT CONFIGURATION (Hardhat) ---
PRIVATE_KEY=your_private_key_here_with_0x_prefix
TREASURY_ADDRESS=your_wallet_address_to_receive_fees
STATE_CONNECTOR_ADDRESS=0x1234567890123456789012345678901234567890
TEST_TOKEN_ADDRESS=0x... # Address of the ERC20 token you want to test whitelisting

# --- EXPLORER VERIFICATION ---
SNOWTRACE_API_KEY=your_snowtrace_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# --- RELAYER CONFIGURATION (Go) ---
# The Bridge contract address after you run 'npx hardhat run scripts/deploy.ts --network avalancheFuji'
BRIDGE_ADDRESS=0x...
RELAYER_KEY=your_relayer_private_key_without_0x_prefix
AVAX_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# --- FRONTEND ---
NEXT_PUBLIC_BRIDGE_ADDRESS_FUJI=0x...
NEXT_PUBLIC_BRIDGE_ADDRESS_COSTON2=0x...
